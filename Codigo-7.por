programa
{
	
real n1, n2, n3, n4, mf
	funcao inicio()
	{
		escreva("Digite a nota 1\n")
		leia(n1)
		escreva("Digite a nota 2\n")
		leia(n2)
		escreva("Digite a nota 3\n")
		leia(n3)
		escreva("Digite a nota 4\n")
		leia(n4)
		limpa()

		mf = (n1 + n2 + n3 + n4)/4

		escreva("Sua media final eh ", mf)

	}
}
