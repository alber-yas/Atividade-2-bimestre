programa
{
	
	funcao inicio()
	{
	real larguraMaraca, area, dobroArea, comprimentoMaraca, dobroAreaCm
	
		larguraMaraca = 32.0
		comprimentoMaraca = 317.0
		area = larguraMaraca * comprimentoMaraca /2
		dobroArea = area * 2
		dobroAreaCm = dobroArea * 100

		escreva("A area do Maracana eh ", area, " m\nO dobro da area eh ", dobroArea, " m\nO dobro da area em centimetros eh ", dobroAreaCm, " cm")

	}
}
